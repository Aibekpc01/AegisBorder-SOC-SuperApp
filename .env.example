# Скопируйте в .env и задайте свои случайные значения без символов #, @, : и пробелов
DB_PASSWORD=replace_with_long_random_database_password
ADMIN_PASSWORD=replace_with_long_random_admin_password
AUDIT_KEY=replace_with_random_secret_at_least_32_characters
TRUSTED_PROXY_CIDRS=

# false отключает официальные эмблемы на публичном лендинге после сборки.
VITE_PUBLIC_OFFICIAL_EMBLEMS=true
